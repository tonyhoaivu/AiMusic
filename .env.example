# GEMINI_API_KEY: Required for Gemini AI lyrics composition and music style analysis.
GEMINI_API_KEY=""

# AI_MUSIC_PROVIDER: Active AI Music provider ('suno', 'minimax', 'replicate', 'fal', 'custom')
AI_MUSIC_PROVIDER="suno"

# External AI Music & AI Cover Provider Keys
SUNO_API_KEY=""
REPLICATE_API_TOKEN=""
MINIMAX_API_KEY=""
FAL_KEY=""
AI_MUSIC_BASE_URL="https://api.sunoapi.org"
AI_MUSIC_MODEL="V3_5"

# Admin Account Seed & Auth Session Security
ADMIN_EMAIL="admin@aimusicstudio.com"
ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# Storage & Hosting
DATA_DIR="./data"
APP_URL="http://localhost:3000"
PORT=3000
NODE_ENV="production"
